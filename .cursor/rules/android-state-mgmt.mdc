## 6. ViewModel 模板

```kotlin
@HiltViewModel
class {Feature}ViewModel @Inject constructor(
    private val getDataUseCase: Get{Feature}DataUseCase,
    private val saveDataUseCase: Save{Feature}DataUseCase,
    @IODispatcher private val ioDispatcher: CoroutineDispatcher,
) : ViewModel() {

    private val _uiState = MutableStateFlow({Feature}UiState())
    val uiState: StateFlow<{Feature}UiState> = _uiState.asStateFlow()

    init {
        loadData()
    }

    fun onIntent(intent: {Feature}Intent) {
        when (intent) {
            is {Feature}Intent.Refresh -> loadData()
            is {Feature}Intent.Save -> saveData(intent.data)
        }
    }

    private fun loadData() {
        viewModelScope.launch {
            _uiState.update { it.copy(isLoading = true) }
            getDataUseCase()
                .onSuccess { data ->
                    _uiState.update { it.copy(isLoading = false, data = data, error = null) }
                }
                .onFailure { err ->
                    _uiState.update { it.copy(isLoading = false, error = err as? {Feature}Error) }
                }
        }
    }

    private fun saveData(data: Data) { /* ... */ }
}

// Intent 和 Error 定义
sealed interface {Feature}Intent
sealed interface {Feature}Error
```

