## 2. 协程规范

### 强制要求
- **禁止使用** `GlobalScope`，必须使用 `viewModelScope` 或注入的 `CoroutineDispatcher`
- **禁止硬编码** `Dispatchers.IO`，使用注入的 `IODispatcher`
- **禁止在 Composable 内直接调用** suspend 函数，必须用 `LaunchedEffect` 或 `rememberCoroutineScope`
- ViewModel 中业务逻辑统一走 `UseCase`，不直接调用 Repository

### 正确写法
```kotlin
// ✅ 使用注入的 Dispatcher
@Singleton
class MessageRepository @Inject constructor(
    @IODispatcher private val ioDispatcher: CoroutineDispatcher,
    private val api: MessageApi,
    private val db: MessageDao
) {
    suspend fun fetchMessages(): Result<List<Message>> =
        withContext(ioDispatcher) { /* ... */ }
}

// ✅ Composable 中正确使用协程
@Composable
fun ChatScreen(vm: ChatViewModel = hiltViewModel()) {
    val uiState by vm.uiState.collectAsStateWithLifecycle()
    val snackbarHostState = remember { SnackbarHostState() }

    // 正确：LaunchedEffect 捕获 key
    LaunchedEffect(vm.uiState.value.error) {
        vm.uiState.value.error?.let {
            snackbarHostState.showSnackbar(it.message)
        }
    }
}
```

### 禁止写法
```kotlin
// ❌ GlobalScope
GlobalScope.launch { /* ... */ }

// ❌ 硬编码 Dispatcher
withContext(Dispatchers.IO) { /* ... */ }

// ❌ Composable 中直接调 suspend
@Composable
fun Bad() {
    val data = viewModel.loadData() // ❌ 不能直接调用 suspend
}

// ❌ ViewModel 直接调 Repository
class BadViewModel : ViewModel() {
    fun load() {
        viewModelScope.launch {
            repository.getData() // ❌ 应该走 UseCase
        }
    }
}
```

