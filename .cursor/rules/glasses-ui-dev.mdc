## 19. 动态焦点

### 运行时动态添加焦点视图

使用 `addFocusView` 扩展函数动态添加焦点目标。

```kotlin
class DynamicFocusTargetActivity : BaseMirrorActivity<LayoutDynamicBinding>() {

    private val focusHandles = mutableListOf<FocusViewHandle<View>>()
    private var currentDynamicFocus: FocusViewHandle<View>? = null

    private fun addDynamicFocus() {
        var handle: FocusViewHandle<View>? = null
        handle = mBindingPair.addFocusView(
            parent = mBindingPair.left.llParent,
            viewFactory = {
                Button(this@DynamicFocusTargetActivity).apply {
                    text = "动态按钮"
                    background = null
                }
            },
            focusHolder = focusHolder,
            focusConfig = {
                layoutParamsFactory = { parent, view ->
                    LinearLayout.LayoutParams(150.dp, LayoutParams.WRAP_CONTENT).apply {
                        setMargins(20.dp, 5.dp, 20.dp, 5.dp)
                    }
                }
                eventHandler = { action ->
                    when (action) {
                        is TempleAction.Click -> FToast.show("动态按钮点击")
                    }
                }
                onFocusChange = { view, hasFocus, isLeft ->
                    triggerFocus(hasFocus, view, isLeft)
                }
            }
        )

        focusHandles.add(handle!!)
        currentDynamicFocus = handle
    }

    private fun removeDynamicFocus() {
        currentDynamicFocus?.clearFocusView()
    }
}
```

### 移除动态焦点

```kotlin
currentDynamicFocus.clearFocusView()
```

