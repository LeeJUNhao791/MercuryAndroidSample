## 3. 焦点系统规范

### 概述

眼镜上没有触控屏，用户通过镜腿触摸板操作 UI。焦点系统决定了**哪个视图响应触摸事件**。所有可交互的 UI 元素必须注册为焦点目标。

### 核心组件

| 组件 | 作用 |
|---|---|
| `FixPosFocusTracker` | 固定位置焦点追踪器，适合静态 UI（按钮列表） |
| `RecyclerViewSlidingTracker` | RecyclerView 滑动焦点追踪器，适合列表滚动 |
| `FocusHolder` | 焦点容器，管理多个 `FocusInfo` |
| `FocusInfo` | 单个焦点的配置（视图、事件处理器、焦点变化处理器） |
| `make3DEffectForSide(view, isLeft, hasFocus)` | 为焦点视图应用 3D 视觉效果 |

### 两种焦点模式

**模式 A：固定焦点（FixPosFocusTracker）** — 适用于按钮列表、菜单等固定布局

**模式 B：RecyclerView 滑动焦点（RecyclerViewSlidingTracker）** — 适用于可滚动列表，焦点固定在屏幕中央

### 3.1 固定焦点（FixPosFocusTracker）

#### 正确模板

```kotlin
class MyActivity : BaseMirrorActivity<LayoutMyBinding>() {
    private var fixPosFocusTracker: FixPosFocusTracker? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        initFocusTarget()  // ✅ 先初始化焦点
        initEvent()        // ✅ 再初始化事件监听
    }

    private fun initFocusTarget() {
        val focusHolder = FocusHolder()  // FocusHolder(false) 禁用循环导航

        mBindingPair.setLeft {
            val focusTargets = mutableListOf<FocusInfo>()
            var firstFocusView: View? = null

            fun addFocusTarget(view: View, onClick: () -> Unit) {
                if (view.visibility != View.VISIBLE) return  // ✅ 跳过不可见视图
                if (firstFocusView == null) firstFocusView = view

                focusTargets += FocusInfo(
                    view,
                    eventHandler = { action ->
                        when (action) {
                            is TempleAction.Click -> onClick()
                            else -> Unit
                        }
                    },
                    focusChangeHandler = { hasFocus ->
                        mBindingPair.updateView {
                            triggerFocus(hasFocus, view, mBindingPair.checkIsLeft(this))
                        }
                    }
                )
            }

            // 注册所有可交互视图
            addFocusTarget(btnFirst) { navigateToFirst() }
            addFocusTarget(btnSecond) { navigateToSecond() }

            if (focusTargets.isNotEmpty()) {
                focusHolder.addFocusTarget(*focusTargets.toTypedArray())
                firstFocusView?.let { focusHolder.currentFocus(it) }
            }
        }

        fixPosFocusTracker = FixPosFocusTracker(focusHolder).apply {
            focusObj.reqFocus()
        }
    }

    private fun initEvent() {
        lifecycleScope.launch {
            repeatOnLifecycle(Lifecycle.State.RESUMED) {
                templeActionViewModel.state.collect { action ->
                    when (action) {
                        is TempleAction.DoubleClick -> finish()  // ✅ 双击返回
                        else -> fixPosFocusTracker?.handleFocusTargetEvent(action)
                    }
                }
            }
        }
    }
}
```

### 3.2 RecyclerView 滑动焦点

适用于联系人列表、文件列表等需要滚动的场景。焦点固定在屏幕中央，滑动浏览时列表内容滚动但焦点框不动。

```kotlin
class ListActivity : BaseMirrorActivity<LayoutRecyclerBinding>() {
    private lateinit var slidingTracker: RecyclerViewSlidingTracker

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        slidingTracker = RecyclerViewSlidingTracker(
            ViewPair(mBindingPair.left.recyclerView, mBindingPair.right.recyclerView)
        )
        initView()
        initEvent()
        slidingTracker.focusObj.hasFocus = true  // ✅ 激活焦点
    }

    private fun initView() {
        mBindingPair.updateView {
            val isLeft = mBindingPair.checkIsLeft(this)
            recyclerView.apply {
                layoutManager = LinearLayoutManager(context)
                adapter = MyAdapter(context, isLeft, slidingTracker).apply {
                    setData(contactList)
                }
                itemAnimator = null  // ✅ 必须禁用动画
                val snapHelper = StartSnapHelper(41.dp)
                snapHelper.attachToRecyclerView(this)
                setTag(R.id.tag_snap_helper, snapHelper)
            }
            make3DEffectForSide(ivSelectHover, isLeft, isLeft)
            slidingTracker.setCurrentSelectPos(0)
            setViewVisible(true, ivSelectHover)
        }
    }

    private fun initEvent() {
        lifecycleScope.launchWhenResumed {
            val vm = ViewModelProvider(this@ListActivity).get<TempleActionViewModel>()
            vm.state.collect {
                if (!slidingTracker.focusObj.hasFocus || !isActive || it.consumed) return@collect
                slidingTracker.handleActionEvent(it) { action ->
                    when (action) {
                        is TempleAction.DoubleClick -> finish()
                        is TempleAction.Click -> {
                            if (!action.consumed) {
                                FToast.show((adapter as MyAdapter).getCurrentData()?.name ?: "")
                            }
                        }
                        else -> {}
                    }
                }
            }
        }
    }
}
```

### 焦点样式规范

焦点效果通过 `triggerFocus` 方法统一实现：

```kotlin
private fun triggerFocus(hasFocus: Boolean, view: View, isLeft: Boolean) {
    // 背景色：获得焦点时使用主题色，失去焦点时黑色
    view.setBackgroundColor(
        getColor(if (hasFocus) R.color.color_rayneo_theme_0 else R.color.black)
    )
    // 3D 效果：增强眼镜显示的立体感
    make3DEffectForSide(view, isLeft, hasFocus)
}
```

### 强制要求

- 所有可交互视图必须注册为焦点目标，**不可交互的视图（如纯文本 Label）不需要注册**
- 跳过不可见视图（`visibility != View.VISIBLE`）
- 第一个可见视图自动获得初始焦点：`focusHolder.currentFocus(firstView)`
- 注册后必须调用 `fixPosFocusTracker.focusObj.reqFocus()` 激活焦点
- **禁止**在 `onCreate` 之外注册焦点目标（焦点应在 Activity 启动时一次性注册完毕）

### 禁止写法

```kotlin
// ❌ 不注册焦点目标，导致触摸板无法交互
class BadActivity : BaseMirrorActivity<LayoutBadBinding>() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        // ❌ 没有 initFocusTarget()，按钮无法响应触摸板
        btnConfirm.setOnClickListener { doSomething() }  // ❌ View.OnClickListener 无效
    }
}

// ❌ 在运行时动态注册焦点
private fun onDataLoaded() {
    // ❌ 焦点系统不支持动态添加，需要在 initFocusTarget() 中一次性注册
    focusHolder.addFocusTarget(FocusInfo(...))  // ❌ 不推荐
}
```

