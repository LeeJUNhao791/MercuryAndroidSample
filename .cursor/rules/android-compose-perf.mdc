## 2. 状态管理规范

### 强制要求
- ViewModel 用 `StateFlow<UiState>`，Composable 用 `collectAsStateWithLifecycle()` 收集
- 一次性事件（导航、Toast）用 **Effect**（`Channel` / `SharedFlow`）而不是 State
- 状态用 `remember` 包装，需要持久化的状态用 `rememberSaveable`
- 避免在重组中执行副作用（IO、动画除外）

### 正确写法
```kotlin
// ✅ UiState + Effect 分离
@HiltViewModel
class CartViewModel @Inject constructor(
    private val checkoutUseCase: CheckoutUseCase
) : ViewModel() {

    private val _uiState = MutableStateFlow(CartUiState())
    val uiState: StateFlow<CartUiState> = _uiState.asStateFlow()

    // 一次性事件用 Channel
    private val _effect = Channel<CartEffect>(Channel.BUFFERED)
    val effect: Flow<CartEffect> = _effect.receiveAsFlow()

    fun checkout() {
        viewModelScope.launch {
            _uiState.update { it.copy(isLoading = true) }
            checkoutUseCase()
                .onSuccess {
                    _effect.send(CartEffect.NavigateToSuccess)  // 一次性事件
                }
                .onFailure { err ->
                    _effect.send(CartEffect.ShowError(err.message))
                }
                .also { _uiState.update { it.copy(isLoading = false) } }
        }
    }
}

// ✅ Composable 收集 Effect
@Composable
fun CartScreen(vm: CartViewModel = hiltViewModel()) {
    val uiState by vm.uiState.collectAsStateWithLifecycle()

    LaunchedEffect(Unit) {
        vm.effect.collect { effect ->
            when (effect) {
                is CartEffect.NavigateToSuccess -> navController.navigate("success")
                is CartEffect.ShowError -> snackbarHostState.showSnackbar(effect.message)
            }
        }
    }
}

// ✅ 正确防抖
LaunchedEffect(query) {
    snapshotFlow { query }
        .debounce(300)
        .filter { it.isNotBlank() }
        .collect { vm.search(it) }
}
```

