<?xml version="1.0" encoding="utf-8"?>
<!--
    WeNet 语音识别界面布局
    用于 AR 眼镜双目显示，包含识别结果文本框、音频波形动画和录音按钮
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:VoiceRect="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.mobvoi.wenet.WenetActivity">

    <!--
        语音识别结果文本框
        显示识别出的文本内容，支持 15 行文字显示
        背景色为黑色，字体大小为 30sp，适合眼镜上阅读
    -->

    <TextView
      android:id="@+id/textView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:background="@color/black"
      android:maxLines="15"
      android:minLines="15"
      android:text="TextView"
      android:textSize="30sp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.08" />

    <!--
        语音波形动画视图
        自定义控件，显示录音时的音频波形动画效果
        包含 50 个矩形条，颜色为绿色，动画速度为 300ms
    -->
    <com.mobvoi.wenet.VoiceRectView
      android:id="@+id/voiceRectView"
      android:layout_width="0dp"
      android:layout_height="150dp"
      VoiceRect:RectCount="50"
      VoiceRect:RectDownColor="@color/green"
      VoiceRect:RectOffset="0"
      VoiceRect:RectSpeed="300"
      VoiceRect:RectTopColor="@color/green"
      app:layout_constraintBottom_toTopOf="@+id/button"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/textView" />

    <!--
        录音控制按钮
        用于开始/停止录音，文本内容会根据录音状态动态更新
        默认显示"加载中"文本
    -->
    <Button
      android:id="@+id/button"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/wenet_loading"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="1.0"
      app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>